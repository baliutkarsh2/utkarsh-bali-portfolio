{
  "name": "board-dark",
  "type": "dark",
  "colors": { "editor.background": "#121214", "editor.foreground": "#F2F1EC" },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8A8984", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#E8B49A" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "constant.character"],
      "settings": { "foreground": "#C9D3A0" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other"],
      "settings": { "foreground": "#FF6A2B" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#A9C7E0" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#CDBDE8" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#F2F1EC" }
    },
    {
      "scope": ["variable.parameter", "meta.object-literal.key", "support.variable.property"],
      "settings": { "foreground": "#D6D5CF" }
    },
    {
      "scope": ["punctuation", "meta.brace", "keyword.operator"],
      "settings": { "foreground": "#A6A5A0" }
    },
    {
      "scope": ["entity.name.tag", "entity.other.attribute-name"],
      "settings": { "foreground": "#E8B49A" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#C9D3A0" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#F0A6B0" }
    }
  ]
}
